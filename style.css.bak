:root {
  --bg: #191919;
  --text: #000000;
  --textLeft: #e5e5e5;
  --link: #80bfff;
  --link-hover: #e357ff;
  --icon: #4f4f4f;
  --card-surface: #cccccc;
  --gallery-bg: #000000;
  --gallery-gap: 6px;

  /* rhythm */
  --card-pad: 10px;
  --gap-xs: 10px;
  --gap-s: 10px;
  --gap-m: 20px;
  --gap-l: 40px;

  /* cards */
  --thumb-radius: 5px;
  --card-radius: 5px;

  /* layout numbers */
  --page-margin-x: 40px;
}

* {
  box-sizing: border-box;
}

html,
body {
  height: 100%;
}

body {
  margin: 0;
  font-family: "Mulish", sans-serif;
  color: var(--text);
  background: var(--bg);
}

.layout {
  display: flex;
}

.space {
  flex-shrink: 0;
}

.space-left,
.space-right {
  width: 0%;
}

.page {
  margin: 0 var(--page-margin-x) 40px var(--page-margin-x);
  gap: 30px;
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.sidebar {
  display: grid;
  padding: 120px 0 40px 0;
  gap: 20px;
  color: var(--textLeft);
  flex: 0 1 clamp(200px, 22%, 100vw);
  min-width: 0;
}

.content {
  flex: 1;
  min-width: 0;
}

.cards {
  display: flex;
  flex-direction: column;
  gap: 24px;
  padding-top: 0;
}

.card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: var(--card-radius);
  background: var(--card-surface);
}

.card-gallery-wrap {
  position: relative;
}

.card-gallery {
  display: flex;
  gap: var(--gallery-gap);
  overflow-x: auto;
  overflow-y: hidden;
  padding: 10px;
  background: var(--gallery-bg);
  overscroll-behavior-x: contain;
  scrollbar-width: none;
  cursor: grab;
  user-select: none;
}

.card-gallery::-webkit-scrollbar {
  display: none;
}

.card-gallery.is-dragging {
  cursor: grabbing;
}

.gallery-item {
  flex: 0 0 clamp(180px, 42vw, 300px);
  aspect-ratio: 9 / 16;
  border-radius: var(--thumb-radius);
  overflow: hidden;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  pointer-events: none;
}

.card-gallery-hint {
  position: absolute;
  right: 18px;
  bottom: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  background: rgb(0 0 0 / 55%);
  color: #ffffff;
  font-size: 20px;
  line-height: 1;
  pointer-events: none;
}

.card-footer {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 18px 20px 20px 20px;
  background: var(--card-surface);
}

.card-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  font-size: 14px;
  line-height: 1.5;
}

.card-links a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 14px;
  border-radius: 5px;
  background: var(--icon);
  color: var(--textLeft);
  text-decoration: none;
  font-weight: 600;
  transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
}

.card-links a:hover {
  box-shadow: 0 0 40px rgb(238 0 255 / 25%);
  background: var(--bg);
}

.card-links a:active {
  transform: translateY(0px);
}

.card-links a:focus-visible {
  outline: 2px solid var(--link);
  outline-offset: 2px;
}

.name-card,
.contacts-card,
.sidebar-block {
  border-radius: var(--card-radius);
  padding: var(--card-pad);
  background-color: rgb(36, 36, 36);
}

.name {
  margin: 0;
  font-size: 25px;
  line-height: 1.5;
  font-weight: 400;
}

.sidebar-text {
  display: flex;
  flex-direction: column;
  gap: var(--gap-xs);
  font-size: 14px;
  line-height: 1.5;
  font-weight: 400;
}

.sidebar-title {
  margin: 0 0 var(--gap-m);
  font-size: 18px;
  font-weight: 400;
}

.sidebar-block p {
  margin: 0;
}

.sidebar-block p + p {
  margin-top: 12px;
}

.contacts-list {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: var(--gap-s);
}

.contact-item {
  display: grid;
  align-items: center;
}

.contact-icon {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  flex: 0 0 30px;
}

.contact-icon .icon {
  width: 30px;
  height: 30px;
  display: block;
  color: var(--link);
  fill: currentColor;
  opacity: 0.85;
}

.contact-item:hover .contact-icon .icon {
  color: var(--link-hover);
}

.contact-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--textLeft);
  text-decoration: none;
}

.contact-link:hover {
  color: var(--link-hover);
}

.contact-link-text {
  font-size: 14px;
  line-height: 1.4;
}

@media (max-width: 900px) {
  .page {
    flex-direction: column;
    gap: 20px;
  }

  .sidebar {
    width: 100%;
    padding-bottom: 0;
  }

  .content {
    width: 100%;
  }

  .gallery-item {
    flex-basis: min(78vw, 420px);
  }
}

@media (max-width: 640px) {
  :root {
    --page-margin-x: 16px;
  }

  .sidebar {
    padding-top: 24px;
  }

  .card-gallery {
    padding: 8px;
  }

  .gallery-item {
    flex-basis: 82vw;
  }

  .card-footer {
    padding: 16px;
  }

  .card-gallery-hint {
    right: 14px;
    bottom: 14px;
  }
}
